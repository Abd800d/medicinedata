# ── MDA · MedicineData — server configuration ─────────────────────────────
# Copy to .env and adjust. All values are optional: the app runs without them.

# Server
PORT=4000
HOST=0.0.0.0
# NODE_ENV=production is set by `npm start`

# Storage
# DATA_DIR=./data
# DB_FILE=./data/mda.db
# UPLOAD_DIR=./data/uploads

# Security — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
OWNER_EMAIL=7a8b1d@gmail.com
# Initial admin password (only used on first seed)
ADMIN_PASSWORD=MDAadmin@2026

# Google Sign-In (Google Cloud Console → OAuth client → Web)
GOOGLE_CLIENT_ID=

# Google Programmable Search for product images
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# AI assistant (OpenAI-compatible endpoint; works with OpenAI, Azure, Groq, OpenRouter, local vLLM…)
# OPENAI_API_KEY= is accepted as an alias of AI_API_KEY
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini

# Support / contact
WHATSAPP_NUMBER=+967781733795
SUPPORT_EMAIL=7a8b1d@gmail.com
