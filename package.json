{
  "name": "medicinedata",
  "version": "1.2.0",
  "private": true,
  "description": "MDA — MedicineData: pharmaceutical reference, Yemen/Arab market products, prescriptions and pharmacy management.",
  "type": "module",
  "author": "Dr. Abdulmajeed Abdullah Almakhedhi",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node server/index.js\" \"vite\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "prebuild": "node scripts/sync-core.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "bundle:data": "node scripts/build-offline-bundle.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "smoke": "esbuild src/smoke-entry.tsx --bundle --format=esm --platform=browser --jsx=automatic --outfile=.smoke/app.mjs --log-level=error && node scripts/smoke.mjs",
    "images:apply": "node scripts/apply-images.mjs",
    "images:check": "node scripts/apply-images.mjs --check",
    "images:fetch": "node scripts/fetch-images.mjs",
    "barcodes": "node scripts/assign-barcodes.mjs",
    "bundle:data:check": "node scripts/build-offline-bundle.mjs --out /tmp/catalog.check.json",
    "test:rx": "node scripts/test-rx.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@zxing/browser": "^0.1.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.1"
  },
  "engines": {
    "node": ">=20"
  }
}
